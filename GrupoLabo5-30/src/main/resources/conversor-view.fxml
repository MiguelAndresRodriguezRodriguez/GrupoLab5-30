<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="400.0" spacing="20.0" styleClass="root" stylesheets="@styles.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17" fx:controller="controller.ConversorController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label styleClass="title" text="Valor de las unidades de longitud" />

    <VBox alignment="CENTER" spacing="5.0">
        <Label styleClass="info-label" text="1 cm. = 0.01 mt." />
        <Label styleClass="info-label" text="1 mt. = 100 cm." />
    </VBox>

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Cantidad:" />
        <TextField fx:id="txtCantidad" prefWidth="120.0" />
    </HBox>

    <Label styleClass="subtitle" text="Convertir" />

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="De:" />
        <ComboBox fx:id="cbDe" prefWidth="110.0" />
        <Label text="➔ A:" />
        <ComboBox fx:id="cbA" prefWidth="110.0" />
    </HBox>

    <Button mnemonicParsing="false" onAction="#onConvertirClick" styleClass="btn-convertir" text="Convertir" />

    <Label fx:id="lblResultado" styleClass="resultado" text="Resultado" wrapText="true" textAlignment="CENTER"/>
</VBox>